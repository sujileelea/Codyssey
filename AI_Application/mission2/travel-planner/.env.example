# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올라가지 않는다.
GEMINI_API_KEY=
KAKAO_REST_API_KEY=

# 선택 — 장소 검색 제공자 (기본 kakao). naver 로 바꾸면 아래 두 키가 필요
# PLACE_PROVIDER=naver
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# 웹 화면 카카오 지도용 JavaScript 키 (없으면 OpenStreetMap)
# KAKAO_JS_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# REQUEST_TIMEOUT=60
